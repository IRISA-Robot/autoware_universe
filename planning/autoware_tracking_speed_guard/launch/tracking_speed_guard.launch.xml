<?xml version="1.0"?>
<launch>
  <arg name="tracking_speed_guard_param_path"
       default="$(find-pkg-share autoware_tracking_speed_guard)/config/tracking_speed_guard.param.yaml"/>

  <!--
    Runs beside the trajectory follower: same trajectory, same odometry, and the same two
    errors the MPC computes. The difference is the output, which is only a speed cap on
    the external velocity limit channel. It steers nothing and plans nothing.
  -->
  <node pkg="autoware_tracking_speed_guard" exec="tracking_speed_guard_node"
        name="tracking_speed_guard" namespace="/planning" output="screen">
    <param from="$(var tracking_speed_guard_param_path)"/>
  </node>
</launch>
