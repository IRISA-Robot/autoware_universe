  Launch: autoware_pedestrian_light_detector (Phase 1 MOCK)

  Node runs under namespace /perception/road_crossing so that the node name
  becomes /perception/road_crossing/pedestrian_light_detector.
  Service and topic use absolute names (prefixed '/') so they resolve to
  exactly the contract paths regardless of any namespace.
-->
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="param_file"
       default="$(find-pkg-share autoware_pedestrian_light_detector)/config/pedestrian_light_detector.param.yaml"/>
  <!-- backend selector: run script baca dari param_file lalu pass ke sini (atau via env
       RC_PL_BACKEND). Selalu di-set (override param_file dgn nilai yang sama). Default 'hsv'
       buat pemakaian standalone tanpa run script. -->
  <arg name="backend" default="hsv"/>
  <!-- backend=autoware: true = clf/rois is a loose search ROI for autoware_traffic_light_fine_detector
       (launched by tier4_road_crossing_component), plus fine/expect_rois. -->
  <arg name="fine_detector" default="false"/>
  <!-- backend=autoware: fullframe | fine | none ('' = follow fine_detector). -->
  <arg name="roi_refiner" default=""/>
  <!-- Lanelet2 OSM the tf_pedestrian lights are read from: must be the map Autoware runs on,
       or the lights (and their ids, paired with road_crossing lanelets) don't match. -->
  <arg name="map_path" default="/home/ubuntu/sim_ws/maps/map1/lanelet2_map.osm"/>

  <node
    pkg="autoware_pedestrian_light_detector"
    exec="pedestrian_light_detector_node"
    name="pedestrian_light_detector"
    namespace="/perception/road_crossing"
    output="screen">
    <!-- param file FIRST: in Humble, a node-specific param that appears before the file's
         "/**" section makes the file's values win over every later override. -->
    <param from="$(var param_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="backend" value="$(var backend)"/>
    <param name="autoware_fine_detector" value="$(var fine_detector)"/>
    <param name="autoware_roi_refiner" value="$(var roi_refiner)"/>
    <param name="map_path" value="$(var map_path)"/>
  </node>
</launch>
