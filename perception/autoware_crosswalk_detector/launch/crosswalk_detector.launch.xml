  Launch: autoware_crosswalk_detector (Phase 2 — C++ TensorRT)

  Node berjalan di namespace /perception/road_crossing sehingga nama node
  menjadi /perception/road_crossing/crosswalk_detector.
  Service dan topic menggunakan nama absolut (prefixed '/') agar contract
  persis sama dengan Phase 1 mock dan tidak dipengaruhi namespace.
-->
<launch>
  <arg name="use_sim_time" default="false"/>
  <arg name="build_only"   default="false"/>
  <arg name="param_file"
       default="$(find-pkg-share autoware_crosswalk_detector)/config/crosswalk_detector.param.yaml"/>

  <node
    pkg="autoware_crosswalk_detector"
    exec="crosswalk_detector_node"
    name="crosswalk_detector"
    namespace="/perception/road_crossing"
    output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="build_only"   value="$(var build_only)"/>
    <param from="$(var param_file)"/>
  </node>
</launch>
